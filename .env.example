# Backend
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional remote GenAI. If these are not set, all GenAI buttons still work
# using the built-in deterministic fallback.
# Expected API shape: OpenAI-compatible POST {LLM_BASE_URL}/chat/completions
LLM_PROVIDER_NAME=My LLM Provider
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
